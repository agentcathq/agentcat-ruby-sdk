class MCP::Tool::InputSchema < ::MCP::Tool::Schema
  # pkg:gem/mcp#lib/mcp/tool/input_schema.rb:14
  def missing_required_arguments(arguments); end

  # pkg:gem/mcp#lib/mcp/tool/input_schema.rb:10
  def missing_required_arguments?(arguments); end

  # pkg:gem/mcp#lib/mcp/tool/input_schema.rb:20
  def validate_arguments(arguments); end
end

# pkg:gem/mcp#lib/mcp/tool/input_schema.rb:8
class MCP::Tool::InputSchema::ValidationError < ::StandardError; end

# pkg:gem/mcp#lib/mcp/tool/output_schema.rb:7
class MCP::Tool::OutputSchema < ::MCP::Tool::Schema
  # pkg:gem/mcp#lib/mcp/tool/output_schema.rb:14
  def validate_result(result); end

  private

  # Per SEP-2106, an output schema may be ANY valid JSON Schema 2020-12 document: object, array, primitive,
  # or a root-level composition.
  # Default the root to an object only when no root schema keyword is present, which preserves the wire output
  # of the common `properties`-only shape while leaving e.g. `{ type: "array" }` or `{ oneOf: [...] }` untouched
  # (the old unconditional default merged `type: "object"` into root combinators, producing a wrong schema).
  #
  # pkg:gem/mcp#lib/mcp/tool/output_schema.rb:28
  def apply_default_root_type!; end
end

# Root-level keywords whose presence means the user already chose a root schema shape,
# so no `type: "object"` default should be merged in.
#
# pkg:gem/mcp#lib/mcp/tool/output_schema.rb:12
MCP::Tool::OutputSchema::ROOT_SCHEMA_KEYWORDS = T.let(T.unsafe(nil), Array)

# pkg:gem/mcp#lib/mcp/tool/output_schema.rb:8
class MCP::Tool::OutputSchema::ValidationError < ::StandardError; end

# pkg:gem/mcp#lib/mcp/tool/response.rb:5
class MCP::Tool::Response
  # pkg:gem/mcp#lib/mcp/tool/response.rb:10
  def initialize(content = T.unsafe(nil), deprecated_error = T.unsafe(nil), error: T.unsafe(nil), structured_content: T.unsafe(nil), meta: T.unsafe(nil)); end

  # pkg:gem/mcp#lib/mcp/tool/response.rb:8
  def content; end

  # pkg:gem/mcp#lib/mcp/tool/response.rb:24
  def content_provided?; end

  # pkg:gem/mcp#lib/mcp/tool/response.rb:28
  def error?; end

  # pkg:gem/mcp#lib/mcp/tool/response.rb:8
  def meta; end

  # pkg:gem/mcp#lib/mcp/tool/response.rb:8
  def structured_content; end

  # pkg:gem/mcp#lib/mcp/tool/response.rb:32
  def to_h; end
end

# pkg:gem/mcp#lib/mcp/tool/response.rb:6
MCP::Tool::Response::NOT_GIVEN = T.let(T.unsafe(nil), Object)

# pkg:gem/mcp#lib/mcp/tool/schema.rb:8
class MCP::Tool::Schema
  # pkg:gem/mcp#lib/mcp/tool/schema.rb:58
  def initialize(schema = T.unsafe(nil)); end

  # pkg:gem/mcp#lib/mcp/tool/schema.rb:65
  def ==(other); end

  # pkg:gem/mcp#lib/mcp/tool/schema.rb:69
  def to_h; end

  private

  # Root-type defaulting hook. The base class preserves the historical behavior of defaulting the root
  # to an object schema; `OutputSchema` overrides this because SEP-2106 allows any root schema there.
  #
  # pkg:gem/mcp#lib/mcp/tool/schema.rb:79
  def apply_default_root_type!; end

  # pkg:gem/mcp#lib/mcp/tool/schema.rb:152
  def fully_validate(data); end

  # Strip the top-level `$schema` before validation so the SDK always validates against
  # the 2020-12 metaschema (SEP-2106) regardless of any dialect URI a caller embedded in the document.
  #
  # pkg:gem/mcp#lib/mcp/tool/schema.rb:175
  def schema_for_validation; end

  # Lazily built so a cache hit in `validate_schema!` avoids the schemer construction cost.
  # Memoized per Schema instance because schema content is fixed at construction,
  # so the compiled schemer is reusable across many `fully_validate` calls.
  #
  # Validated against the JSON Schema 2020-12 metaschema per SEP-2106, so `$defs`/`$ref` and
  # the rest of the 2020-12 vocabulary resolve natively.
  #
  # `format: false` preserves the legacy behavior of the previous `json-schema` based implementation,
  # which did not enforce `format` keywords. `RegexpError` from a malformed `pattern` is re-raised as
  # `ArgumentError` so callers see the same exception class they used to.
  #
  # pkg:gem/mcp#lib/mcp/tool/schema.rb:142
  def schemer; end

  # pkg:gem/mcp#lib/mcp/tool/schema.rb:119
  def stringify(obj); end

  # pkg:gem/mcp#lib/mcp/tool/schema.rb:156
  def validate_schema!; end

  # Enforces `MAX_SCHEMA_DEPTH` / `MAX_SUBSCHEMA_COUNT` and the same-document reference rule over
  # the whole schema document.
  #
  # pkg:gem/mcp#lib/mcp/tool/schema.rb:85
  def validate_schema_bounds!; end
end

# JSON Schema 2020-12 is the default dialect for MCP schema definitions per MCP 2025-11-25 (SEP-1613),
# and SEP-2106 requires tool schemas to conform to the full 2020-12 vocabulary. Both emission and
# runtime validation use this dialect. Because MCP mandates 2020-12, the SDK validates against it
# regardless of any `$schema` a document embeds; for compliant schemas this is the same dialect
# the Python SDK's `jsonschema.validate` resolves to.
#
# pkg:gem/mcp#lib/mcp/tool/schema.rb:44
MCP::Tool::Schema::JSON_SCHEMA_2020_12_URI = T.let(T.unsafe(nil), String)

# Resource bounds for schema compilation, mirroring the TypeScript SDK's schema bounds (SEP-2106):
# schemas may use the full JSON Schema 2020-12 vocabulary including composition keywords and `$ref`,
# so adversarial documents must be rejected before they can cause excessive validation cost.
# Only same-document references (starting with `#`) are accepted, so schema handling can never trigger network
# or file access.
#
# pkg:gem/mcp#lib/mcp/tool/schema.rb:51
MCP::Tool::Schema::MAX_SCHEMA_DEPTH = T.let(T.unsafe(nil), Integer)

# pkg:gem/mcp#lib/mcp/tool/schema.rb:52
MCP::Tool::Schema::MAX_SUBSCHEMA_COUNT = T.let(T.unsafe(nil), Integer)

# Reference keywords whose targets the SDK refuses to dereference. Both `$ref` and `$dynamicRef` may carry
# an absolute URI under JSON Schema 2020-12, so a non-same-document value is an external reference.
#
# pkg:gem/mcp#lib/mcp/tool/schema.rb:56
MCP::Tool::Schema::REFERENCE_KEYWORDS = T.let(T.unsafe(nil), Array)

# pkg:gem/mcp#lib/mcp/tool/schema.rb:37
MCP::Tool::Schema::VALIDATION_CACHE = T.let(T.unsafe(nil), MCP::Tool::Schema::ValidationCache)

# Metaschema validation depends only on schema content, so a given schema
# never needs to be validated more than once. Caching the result lets repeated
# (e.g. dynamically rebuilt) schemas skip the costly traversal.
#
# pkg:gem/mcp#lib/mcp/tool/schema.rb:12
class MCP::Tool::Schema::ValidationCache
  # pkg:gem/mcp#lib/mcp/tool/schema.rb:15
  def initialize(max_size: T.unsafe(nil)); end

  # pkg:gem/mcp#lib/mcp/tool/schema.rb:33
  def clear; end

  # pkg:gem/mcp#lib/mcp/tool/schema.rb:25
  def store(key); end

  # pkg:gem/mcp#lib/mcp/tool/schema.rb:21
  def validated?(key); end
end

# pkg:gem/mcp#lib/mcp/tool/schema.rb:13
MCP::Tool::Schema::ValidationCache::DEFAULT_MAX_SIZE = T.let(T.unsafe(nil), Integer)

# pkg:gem/mcp#lib/mcp/server.rb:22
class MCP::ToolNotUnique < ::StandardError
  # pkg:gem/mcp#lib/mcp/server.rb:23
  def initialize(duplicated_tool_names); end
end

# Reserved `_meta` keys for W3C Trace Context propagation, per SEP-414.
#
# The MCP spec reserves the un-prefixed `_meta` keys `traceparent`, `tracestate`, and `baggage`
# (an explicit exception to the reverse-DNS prefix rule for `_meta` keys) so that clients and
# servers can propagate distributed-tracing context across MCP requests.
# The SDK guarantees these keys pass through incoming request `_meta` untouched; tool, prompt,
# and resource handlers can read them from `server_context[:_meta]` and bridge them to a tracing
# system such as the `opentelemetry-ruby` gems. The SDK itself does not depend on OpenTelemetry.
#
# - https://github.com/modelcontextprotocol/modelcontextprotocol/pull/414
# - https://www.w3.org/TR/trace-context/
# - https://www.w3.org/TR/baggage/
#
# pkg:gem/mcp#lib/mcp/trace_context.rb:16
module MCP::TraceContext; end

# pkg:gem/mcp#lib/mcp/trace_context.rb:19
MCP::TraceContext::BAGGAGE_META_KEY = T.let(T.unsafe(nil), String)

# pkg:gem/mcp#lib/mcp/trace_context.rb:21
MCP::TraceContext::META_KEYS = T.let(T.unsafe(nil), Array)

# pkg:gem/mcp#lib/mcp/trace_context.rb:17
MCP::TraceContext::TRACEPARENT_META_KEY = T.let(T.unsafe(nil), String)

# pkg:gem/mcp#lib/mcp/trace_context.rb:18
MCP::TraceContext::TRACESTATE_META_KEY = T.let(T.unsafe(nil), String)

# pkg:gem/mcp#lib/mcp/transport.rb:6
class MCP::Transport
  # Initialize the transport with the server instance
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:8
  def initialize(server); end

  # Close the transport connection
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:24
  def close; end

  # Handle a JSON request
  # Returns a response that should be sent back to the client
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:30
  def handle_json_request(request); end

  # Handle an incoming request
  # Returns a response that should be sent back to the client
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:37
  def handle_request(request); end

  # Open the transport connection
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:19
  def open; end

  # Send a notification to the client.
  # Returns true if the notification was sent successfully.
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:44
  def send_notification(method, params = T.unsafe(nil)); end

  # Send a JSON-RPC request to the client and wait for a response.
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:49
  def send_request(method, params = T.unsafe(nil)); end

  # Send a response to the client
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:14
  def send_response(response); end

  # Whether the transport serves the `subscriptions/listen` notification stream (MCP 2026-07-28, SEP-2575).
  # `Server#discover` strips the `listChanged`/`subscribe` capability flags when the transport cannot deliver
  # those notifications in the modern lifecycle.
  #
  # pkg:gem/mcp#lib/mcp/transport.rb:56
  def serves_subscriptions_listen?; end

  private

  # pkg:gem/mcp#lib/mcp/transport.rb:62
  def generate_request_id; end
end

# pkg:gem/mcp#lib/mcp/version.rb:4
MCP::VERSION = T.let(T.unsafe(nil), String)
